---
import { ThemeToggle } from "@web/components/ThemeToggle.tsx";
import { DASHBOARD_RELEASED, DASHBOARD_URL } from "../data/release";
import Mark from "./Mark.astro";
import { showBenchmark } from "../lib/benchmark";
interface Props { path: string }
const { path } = Astro.props;
const links = [
  { href: "/#compare", label: "Compare" },
  ...(showBenchmark ? [{ href: "/benchmark", label: "Benchmark" }] : []),
  { href: "/#platforms", label: "Platforms" },
  { href: "/guides", label: "Guides" },
  { href: "https://github.com/gerolndnr/connection-guard/tree/master/docs", label: "Docs" },
];
---
<header class="sticky top-0 z-30 border-b border-line bg-surface">
  <div class="container-site flex h-14 items-center gap-6">
    <a href="/" class="flex items-center gap-2 whitespace-nowrap text-[0.9375rem] font-semibold tracking-[-0.01em] text-fg no-underline"><Mark class="size-[1.15rem]" />Connection Guard</a>
    <nav aria-label="Main" class="hidden items-center gap-5 lg:flex">
      {links.map((l) => <a href={l.href} class="text-sm text-fg-2 no-underline transition-colors hover:text-fg">{l.label}</a>)}
    </nav>
    <div class="ml-auto flex items-center gap-2 sm:gap-3">
      <a href="https://github.com/gerolndnr/connection-guard" class="btn btn-ghost hidden h-9 lg:inline-flex" aria-label="Source code on GitHub">
        <svg viewBox="0 0 24 24" aria-hidden="true" class="size-4 fill-current"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.47.11-3.06 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.77.11 3.06.74.8 1.19 1.83 1.19 3.09 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>
        GitHub
      </a>
      <ThemeToggle client:load />
      {DASHBOARD_RELEASED && (
        <a href={DASHBOARD_URL} class="btn btn-secondary hidden h-9 gap-1.5 no-underline sm:inline-flex" data-ph-event="cta_clicked" data-ph-cta="dashboard" data-ph-location="nav">
          Dashboard
          <svg viewBox="0 0 16 16" aria-hidden="true" class="size-3.5 text-fg-3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5.5 10.5l5-5M6 5.5h4.5V10"/></svg>
        </a>
      )}
      <a href="/download" class="btn btn-primary h-9 no-underline" data-ph-event="cta_clicked" data-ph-cta="download" data-ph-location="nav" aria-current={path === "/download" ? "page" : undefined}>Download</a>
    </div>
  </div>
  <nav aria-label="Main (compact)" class="border-t border-line lg:hidden">
    <div class="container-site flex h-10 items-center gap-5 overflow-x-auto whitespace-nowrap [scrollbar-width:none]">
      {DASHBOARD_RELEASED && (
        <a href={DASHBOARD_URL} class="flex items-center gap-1.5 text-[0.8125rem] font-medium text-fg no-underline sm:hidden" data-ph-event="cta_clicked" data-ph-cta="dashboard" data-ph-location="nav_compact">
          <span aria-hidden="true" class="size-1.5 rounded-full bg-accent"></span>Dashboard
        </a>
      )}
      {[...links, { href: "https://github.com/gerolndnr/connection-guard", label: "GitHub" }].map((l) => <a href={l.href} class="text-[0.8125rem] text-fg-2 no-underline hover:text-fg">{l.label}</a>)}
    </div>
  </nav>
</header>
