---
import { COLUMNS, ROWS } from "../data/compare";
const icon = { yes: "M5 12.5l4.5 4.5L19 7.5", no: "M6 12h12", varies: "M5 13.5c1.6-2.4 3.4-2.4 5 0s3.4 2.4 5 0 3.4-2.4 4-1" } as const;
const color = { yes: "text-accent", no: "text-fg-3", varies: "text-fg-3" } as const;
const word = { yes: "Yes", no: "No", varies: "Varies" } as const;
---
<div class="hidden overflow-x-auto rounded-2xl border border-line bg-surface md:block">
  <table class="w-full min-w-[44rem] border-collapse text-left text-[0.9375rem]">
    <caption class="sr-only">Connection Guard compared with a typical paid plugin and a typical hosted service</caption>
    <thead>
      <tr class="border-b border-line">
        <th scope="col" class="w-[22%] px-5 py-4 text-sm font-medium text-fg-2"><span class="sr-only">Feature</span></th>
        {COLUMNS.map((c, i) => (
          <th scope="col" class={`px-5 py-4 text-sm font-semibold ${i === 0 ? "bg-accent-soft/60 text-fg" : "text-fg-2"}`}>{c}</th>
        ))}
      </tr>
    </thead>
    <tbody>
      {ROWS.map((r) => (
        <tr class="border-b border-line last:border-0">
          <th scope="row" class="px-5 py-4 align-top text-sm font-medium">
            {r.label}
            {r.soon && <span class="chip chip-soon ml-2 h-5 align-middle text-xs">0.5</span>}
            {r.proof && <a href={r.proof} class="mt-1 block text-[0.8125rem] font-normal text-fg-3 no-underline hover:text-fg hover:underline">See it →</a>}
          </th>
          {r.cells.map((c, i) => (
            <td class={`px-5 py-4 align-top ${i === 0 ? "bg-accent-soft/60" : ""}`}>
              <span class="flex gap-2.5">
                <svg viewBox="0 0 24 24" aria-hidden="true" class={`mt-0.5 size-4 shrink-0 ${color[c.tone]}`} fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d={icon[c.tone]} /></svg>
                <span class={i === 0 ? "font-medium text-fg" : "text-fg-2"}><span class="sr-only">{word[c.tone]}: </span>{c.text}</span>
              </span>
            </td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>
<!-- Small screens: one card per question, all three answers stacked, so the comparison survives. -->
<ul class="divide-y divide-line overflow-hidden rounded-2xl border border-line bg-surface md:hidden">
  {ROWS.map((r) => (
    <li class="px-4 py-4">
      <p class="flex items-center gap-2 text-sm font-semibold">{r.label}{r.soon && <span class="chip chip-soon h-5 text-xs">0.5</span>}
        {r.proof && <a href={r.proof} class="ml-auto text-[0.8125rem] font-normal text-fg-3 no-underline hover:text-fg hover:underline">See it →</a>}</p>
      <dl class="mt-3 space-y-2 text-sm">
        {r.cells.map((c, i) => (
          <div class={`grid grid-cols-[7.5rem_minmax(0,1fr)] gap-3 rounded-md ${i === 0 ? "-mx-2 bg-accent-soft/60 px-2 py-1.5" : "py-0.5"}`}>
            <dt class={i === 0 ? "font-medium text-fg" : "text-fg-3"}>{["Connection Guard", "Paid plugin", "Hosted service"][i]}</dt>
            <dd class="flex gap-2">
              <svg viewBox="0 0 24 24" aria-hidden="true" class={`mt-0.5 size-4 shrink-0 ${color[c.tone]}`} fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d={icon[c.tone]} /></svg>
              <span class={i === 0 ? "font-medium text-fg" : "text-fg-2"}><span class="sr-only">{word[c.tone]}: </span>{c.text}</span>
            </dd>
          </div>
        ))}
      </dl>
    </li>
  ))}
</ul>
<p class="mt-4 flex flex-wrap gap-x-5 gap-y-1 text-[0.8125rem] text-fg-3" aria-hidden="true">
  {(["yes", "no", "varies"] as const).map((t) => (
    <span class="flex items-center gap-1.5"><svg viewBox="0 0 24 24" class={`size-3.5 ${color[t]}`} fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d={icon[t]} /></svg>{word[t]}</span>
  ))}
</p>
<p class="mt-2 max-w-[34rem] text-[0.8125rem] leading-relaxed text-fg-3">
  The other columns describe common setups we reviewed in October 2026, not any single product; individual plugins and services differ, so check their pages before you choose.
  Rows marked <span class="chip chip-soon h-5 text-xs">0.5</span> arrive with Connection Guard 0.5; everything else is in today's release.
</p>
