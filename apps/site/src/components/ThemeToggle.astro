---
// System / light / dark, without React: the site loads no framework for this. Same look and storage key
// ("cg-theme") as the dashboard's ThemeToggle; the inline script in Base.astro applies the stored choice before paint.
const icons = {
  system: '<rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/>',
  light: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>',
  dark: '<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>',
};
const options = [["system", "System theme"], ["light", "Light theme"], ["dark", "Dark theme"]] as const;
const svg = (k: keyof typeof icons, size: string) =>
  `<svg viewBox="0 0 24 24" aria-hidden="true" class="${size}" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${icons[k]}</svg>`;
---
<cg-theme class="contents">
  <!-- Phones: one button that cycles system, light, dark. -->
  <button type="button" data-cycle class="btn btn-ghost size-8 p-0 sm:hidden" aria-label="System theme. Switch to light theme" title="System theme"
    data-ph-event="theme_changed">
    {options.map(([id]) => <span data-icon={id} hidden={id !== "system"}><Fragment set:html={svg(id, "size-4")} /></span>)}
  </button>
  <div role="group" aria-label="Theme" class="hidden rounded-full border border-line p-0.5 sm:flex">
    {options.map(([id, label]) => (
      <button type="button" data-theme={id} aria-label={label} title={label} aria-pressed={id === "system" ? "true" : "false"}
        data-ph-event="theme_changed" data-ph-theme={id}
        class="grid size-6 place-items-center rounded-full text-fg-3 transition-colors hover:text-fg aria-pressed:bg-subtle aria-pressed:text-fg">
        <Fragment set:html={svg(id, "size-3.5")} />
      </button>
    ))}
  </div>
</cg-theme>

<script>
  type Theme = "system" | "light" | "dark";
  const KEY = "cg-theme";
  const ORDER: Theme[] = ["system", "light", "dark"];
  const LABEL: Record<Theme, string> = { system: "System theme", light: "Light theme", dark: "Dark theme" };
  const read = (): Theme => { try { const v = localStorage.getItem(KEY); return v === "light" || v === "dark" ? v : "system"; } catch { return "system"; } };
  const media = window.matchMedia("(prefers-color-scheme: dark)");

  class CgTheme extends HTMLElement {
    connectedCallback() {
      this.render(read());
      this.querySelectorAll<HTMLButtonElement>("[data-theme]").forEach((b) => b.addEventListener("click", () => this.set(b.dataset.theme as Theme)));
      this.querySelector<HTMLButtonElement>("[data-cycle]")?.addEventListener("click", () => this.set(ORDER[(ORDER.indexOf(read()) + 1) % ORDER.length]!));
      media.addEventListener("change", () => { if (read() === "system") this.apply("system"); });
    }
    set(theme: Theme) {
      try { if (theme === "system") localStorage.removeItem(KEY); else localStorage.setItem(KEY, theme); } catch { /* private mode */ }
      this.apply(theme);
      this.render(theme);
    }
    apply(theme: Theme) {
      document.documentElement.classList.toggle("dark", theme === "dark" || (theme === "system" && media.matches));
    }
    render(theme: Theme) {
      this.querySelectorAll<HTMLButtonElement>("[data-theme]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.theme === theme)));
      const cycle = this.querySelector<HTMLButtonElement>("[data-cycle]");
      if (!cycle) return;
      const next = ORDER[(ORDER.indexOf(theme) + 1) % ORDER.length]!;
      cycle.setAttribute("aria-label", `${LABEL[theme]}. Switch to ${LABEL[next].toLowerCase()}`);
      cycle.title = LABEL[theme];
      cycle.dataset.phTheme = next;
      cycle.querySelectorAll<HTMLElement>("[data-icon]").forEach((i) => { i.hidden = i.dataset.icon !== theme; });
    }
  }
  if (!customElements.get("cg-theme")) customElements.define("cg-theme", CgTheme);
</script>
