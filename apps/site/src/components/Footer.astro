---
import Mark from "./Mark.astro";
import { DASHBOARD_RELEASED, DASHBOARD_URL } from "../data/release";
const groups = [
  { title: "Product", links: [["Download", "/download"], ["Compare", "/#compare"], DASHBOARD_RELEASED ? ["Dashboard", DASHBOARD_URL] : ["Dashboard preview", "/#dashboard"], ["Privacy", "/privacy"]] },
  { title: "Platforms", links: [["Paper and Spigot", "/paper-anti-vpn"], ["BungeeCord", "/bungeecord-anti-vpn"], ["Velocity", "/velocity-anti-vpn"]] },
  { title: "Guides", links: [["Block VPNs", "/guides/block-vpn-minecraft-server"], ["Block countries", "/guides/block-countries-minecraft-server"], ["All guides", "/guides"]] },
  { title: "Get it on", links: [["Modrinth", "https://modrinth.com/plugin/connectionguard"], ["SpigotMC", "https://www.spigotmc.org/resources/121509/"], ["Hangar", "https://hangar.papermc.io/gerolndnr/connection-guard"], ["GitHub Releases", "https://github.com/gerolndnr/connection-guard/releases"]] },
  { title: "Open source", links: [["Plugin source (MIT)", "https://github.com/gerolndnr/connection-guard"], ["Dashboard source (AGPL)", "https://github.com/gerolndnr/connection-guard-cloud"], ["Changelog", "https://github.com/gerolndnr/connection-guard/blob/master/CHANGELOG.md"], ["Documentation", "https://github.com/gerolndnr/connection-guard/tree/master/docs"]] },
  { title: "Help", links: [["Get help on Discord", "https://discord.gg/8q4HFCh2RK"], ["Report an issue", "https://github.com/gerolndnr/connection-guard/issues"]] },
];
---
<footer class="border-t border-line bg-surface">
  <div class="container-site grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-[1.3fr_repeat(6,1fr)]">
    <div>
      <p class="flex items-center gap-2 whitespace-nowrap text-[0.9375rem] font-semibold tracking-[-0.01em]"><Mark class="size-[1.15rem]" />Connection Guard</p>
      <p class="mt-2 max-w-xs text-[0.8125rem] leading-relaxed text-fg-2">Free, open-source anti-VPN plugin with country rules for Minecraft servers. Successor to LNDNR's Anti-VPN &amp; Geo-Blocking.</p>
    </div>
    {groups.map((g) => (
      <nav aria-label={g.title}>
        <p class="text-[0.8125rem] font-medium">{g.title}</p>
        <ul class="mt-3 space-y-2">
          {g.links.map(([label, href]) => <li><a href={href} class="text-[0.8125rem] text-fg-2 no-underline hover:text-fg" {...(g.title === "Get it on" ? { "data-ph-event": "download_clicked", "data-ph-destination": label.split(" ")[0]!.toLowerCase(), "data-ph-location": "footer" }
            : g.title === "Help" ? { "data-ph-event": "support_clicked", "data-ph-channel": href.includes("discord") ? "discord" : "github", "data-ph-location": "footer" } : {})}>{label}</a></li>)}
        </ul>
      </nav>
    ))}
  </div>
  <div class="border-t border-line">
    <div class="container-site flex flex-col gap-3 py-5 text-[0.75rem] leading-relaxed text-fg-3 md:flex-row md:items-start md:justify-between md:gap-8">
      <p class="max-w-2xl">
        Not an official Minecraft product. Not approved by or associated with Mojang or Microsoft. This website sets no cookies. Visits are counted anonymously and cookieless with PostHog (EU).
      </p>
      <nav aria-label="Legal" class="flex shrink-0 flex-wrap gap-x-4 gap-y-1">
        <a href="/impressum" lang="de" class="text-fg-2 no-underline hover:text-fg">Impressum</a>
        <a href="/legal-notice" class="text-fg-2 no-underline hover:text-fg">Legal notice</a>
        <a href="/privacy" class="text-fg-2 no-underline hover:text-fg">Privacy</a>
        <a href="/datenschutz" lang="de" class="text-fg-2 no-underline hover:text-fg">Datenschutz</a>
        <a href="/terms" class="text-fg-2 no-underline hover:text-fg">Terms</a>
        <a href="/dpa" class="text-fg-2 no-underline hover:text-fg">DPA</a>
      </nav>
    </div>
  </div>
</footer>
