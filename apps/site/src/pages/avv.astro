  ["daten", "Art der Daten und Betroffene"],
  ["weisungen", "Weisungen"],
  ["pflichten", "Pflichten des Auftragsverarbeiters"],
  ["unterauftrag", "Unterauftragsverarbeiter"],
  ["drittland", "Drittländer"],
  ["unterstuetzung", "Unterstützung"],
  ["loeschung", "Löschung und Rückgabe"],
