import Guide from "../../layouts/Guide.astro";
const faq = [
  { q: "Why do all my players show the same IP behind TCPShield or NeoProtect?", a: "Players connect to the protection service, and the service opens a new connection to your server. Unless it passes the player's address along, your server only sees the service's own addresses. Turn on PROXY protocol in the provider's panel and on your proxy or server, or use the provider's forwarding plugin." },
  { q: "Does Connection Guard work behind DDoS protection?", a: "Yes, as long as the real player address reaches your server. Connection Guard reads the address your proxy or server reports at login. With PROXY protocol on Velocity, BungeeCord or Paper, or with the TCPShield plugin, that is the player's address. We test Velocity and BungeeCord with PROXY protocol v2 directly, and the public benchmark joins every platform through PROXY protocol." },
  { q: "What is PROXY protocol?", a: "A short header that a proxy puts in front of each connection. It carries the client's address and port. Velocity, BungeeCord and Paper can read it natively, so no extra plugin is needed." },
  { q: "Should I enable PROXY protocol on Paper behind Velocity?", a: "No. Enable it only where the protection service connects: on Velocity or BungeeCord in a network, or on Paper when it stands alone. Paper behind Velocity gets the address through Velocity's player info forwarding instead." },
  { q: "Is it safe to enable PROXY protocol?", a: "Only with a firewall. A server that accepts PROXY headers believes whatever address the header names. Allow connections to that port only from your protection service's addresses, so nobody can connect directly and claim any address they like." },
  { q: "Does Cloudflare Spectrum pass the real IP?", a: "Spectrum can add PROXY protocol v1 or v2, but Cloudflare's documentation lists that feature as Enterprise-only. On other plans your server sees Cloudflare's addresses, and no anti-VPN plugin can judge the players behind them." },
];
