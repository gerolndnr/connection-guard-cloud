---
import Base from "./Base.astro";
import { LEGAL_UPDATED, assertOperator } from "../data/operator";
interface Props {
  title: string;
  h1: string;
  description: string;
  path: string;
  lang: "en" | "de";
  alternate: { lang: "en" | "de"; path: string; label: string };
  toc?: [string, string][];
}
const p = Astro.props;
assertOperator();
const updated = new Date(LEGAL_UPDATED).toLocaleDateString(p.lang === "de" ? "de-DE" : "en-GB", { day: "numeric", month: "long", year: "numeric" });
---
<Base title={p.title} description={p.description} path={p.path} lang={p.lang} og="/og/privacy.png"
  alternates={[{ lang: p.lang, path: p.path }, { lang: p.alternate.lang, path: p.alternate.path }]}>
  <header class="border-b border-line">
    <div class="container-site py-12 sm:py-16">
      <h1 class="display text-[clamp(2.25rem,5vw,3.25rem)]">{p.h1}</h1>
      <p class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 text-[0.8125rem] text-fg-3">
        <span>{p.lang === "de" ? "Stand" : "Last updated"}: <time datetime={LEGAL_UPDATED}>{updated}</time></span>
        <a href={p.alternate.path} hreflang={p.alternate.lang} lang={p.alternate.lang} class="font-medium text-fg-2 underline decoration-line-strong underline-offset-4 hover:text-fg">{p.alternate.label}</a>
      </p>
    </div>
  </header>
  <div class={`container-site grid gap-12 py-12 sm:py-16 ${p.toc ? "lg:grid-cols-[13rem_minmax(0,1fr)] lg:gap-16" : ""}`}>
    {p.toc && (
      <nav aria-label={p.lang === "de" ? "Inhalt" : "Contents"} class="hidden lg:block">
        <div class="sticky top-24">
          <p class="text-[0.8125rem] font-medium">{p.lang === "de" ? "Inhalt" : "Contents"}</p>
          <ol class="mt-3 space-y-2 border-l border-line">
            {p.toc.map(([id, label]) => <li><a href={`#${id}`} class="-ml-px block border-l border-transparent pl-3 text-[0.8125rem] leading-snug text-fg-2 no-underline hover:border-fg-3 hover:text-fg">{label}</a></li>)}
          </ol>
        </div>
      </nav>
    )}
    <article class="prose-guide min-w-0"><slot /></article>
  </div>
</Base>
