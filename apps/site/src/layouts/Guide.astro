---
import DownloadCta from "../components/DownloadCta.astro";
import Base from "./Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Faq from "../components/Faq.astro";
import type { Faq as FaqItem } from "../data/platforms";
import { article, breadcrumbs, faq as faqSchema } from "../lib/seo";
import { GUIDES_VERIFIED_FOR } from "../data/release";
interface Props {
  title: string;
  h1: string;
  description: string;
  lede: string;
  path: string;
  og: string;
  published: string;
  modified: string;
  minutes: number;
  toc: [string, string][];
  faq?: FaqItem[];
}
const p = Astro.props;
const fmt = (d: string) => new Date(d).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
const crumbs: [string, string][] = [["Guides", "/guides"], [p.h1, p.path]];
const schema = [article({ title: p.h1, description: p.description, path: p.path, published: p.published, modified: p.modified, image: p.og }), breadcrumbs(crumbs), ...(p.faq ? [faqSchema(p.faq)] : [])];
---
<Base title={p.title} description={p.description} path={p.path} og={p.og} type="article" schema={schema} view={{ event: "guide_opened", guide: p.path.split("/").pop()! }}>
  <header class="border-b border-line">
    <div class="container-site py-12 sm:py-16">
      <Breadcrumbs items={crumbs} />
      <h1 class="display mt-6 max-w-4xl text-[clamp(2.25rem,5vw,3.25rem)]">{p.h1}</h1>
      <p class="lede mt-5">{p.lede}</p>
      <p class="mt-6 text-[0.8125rem] text-fg-3">
        Updated <time datetime={p.modified}>{fmt(p.modified)}</time> · {p.minutes} min read · For Connection Guard {GUIDES_VERIFIED_FOR}
      </p>
    </div>
  </header>
  <div class="container-site grid gap-12 py-12 sm:py-16 lg:grid-cols-[13rem_minmax(0,1fr)] lg:gap-16">
    <nav aria-label="On this page" class="hidden lg:block">
      <div class="sticky top-24">
        <p class="text-[0.8125rem] font-medium">On this page</p>
        <ol class="mt-3 space-y-2 border-l border-line">
          {p.toc.map(([id, label]) => <li><a href={`#${id}`} class="-ml-px block border-l border-transparent pl-3 text-[0.8125rem] leading-snug text-fg-2 no-underline hover:border-fg-3 hover:text-fg">{label}</a></li>)}
        </ol>
      </div>
    </nav>
    <div class="min-w-0">
      <article class="prose-guide"><slot /></article>
      <aside class="card mt-16 flex flex-col items-start justify-between gap-6 p-6 lg:flex-row lg:items-center">
        <div>
          <p class="text-lg font-semibold tracking-[-0.02em]">Try it on your server</p>
          <p class="mt-1 text-sm text-fg-2">Free and open source: every check it runs is public code you can read. One JAR for Paper, Spigot, BungeeCord and Velocity.</p>
        </div>
        <DownloadCta location="guide_end" class="shrink-0 lg:max-w-xs" />
      </aside>
      {p.faq && <div class="mt-16"><Faq items={p.faq} title="Frequently asked questions" /></div>}
      <slot name="after" />
    </div>
  </div>
</Base>
