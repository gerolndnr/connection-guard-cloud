// Connection Guard Cloud worker. Everything here must stay inside the
// Cloudflare Workers Free plan (see docs/CAPACITY.md).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "connection-guard-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/v1/*"]
  },
  "d1_databases": [
    // Production database is created with: wrangler d1 create cg --jurisdiction eu
    { "binding": "DB", "database_name": "cg", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "kv_namespaces": [
    { "binding": "PUBLIC", "id": "00000000000000000000000000000000" }
  ],
  "analytics_engine_datasets": [
    { "binding": "METRICS", "dataset": "cg_sync" }
  ],
  "ratelimits": [
    { "name": "INSTALL_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "SYNC_LIMITER", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
  ],
  "triggers": { "crons": ["*/5 * * * *", "17 3 * * *"] },
  "vars": {
    "ENVIRONMENT": "development",
    "APP_ORIGIN": "http://localhost:8787",
    "DISCORD_CLIENT_ID": "",
    // Cloudflare's documented always-pass Turnstile test site key. Replaced in production.
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "DPA_VERSION": "2026-10-03"
  },
  "env": {
    "production": {
      "routes": [
        { "pattern": "app.connectionguard.net", "custom_domain": true },
        { "pattern": "api.connectionguard.net", "custom_domain": true }
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "APP_ORIGIN": "https://app.connectionguard.net",
        // DISCORD_CLIENT_ID and DISCORD_CLIENT_SECRET are Worker secrets (wrangler secret put ... --env production).
        // Turnstile is optional: set TURNSTILE_SITE_KEY here and the TURNSTILE_SECRET secret to enable it.
        "TURNSTILE_SITE_KEY": "",
        "DPA_VERSION": "2026-10-03",
        // PostHog project token (public). Empty keeps product analytics off; see docs/ANALYTICS.md.
        "POSTHOG_KEY": "phc_zG73iBb7Ss45EkrRE72dqEDamuxs9rCoyEBCJnooCaCe",
        "POSTHOG_HOST": "https://eu.i.posthog.com"
      },
      "d1_databases": [
        // Created with: wrangler d1 create cg --jurisdiction eu
        { "binding": "DB", "database_name": "cg", "database_id": "7bbde5b7-6de2-47ed-950d-af22f2ad9030", "migrations_dir": "migrations" }
      ],
      "kv_namespaces": [
        { "binding": "PUBLIC", "id": "c601f9f0de2649419283c89e0be54ec3" }
      ],
      // Analytics Engine (optional product metrics) needs a one-time enable in the Cloudflare dashboard:
      // Workers & Pages > Analytics Engine. Then restore:
      // "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "cg_sync" }],
      "ratelimits": [
        { "name": "INSTALL_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
        { "name": "SYNC_LIMITER", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
      ]
    }
  }
}
